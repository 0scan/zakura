api.0scan.dev {
    encode zstd gzip

    reverse_proxy backend-app:8000

    log {
        output file /var/log/caddy/api-access.log {
            roll_size 50MiB
            roll_keep 5
        }
    }
}

rpc.0scan.dev {
    encode zstd gzip

    request_body {
        max_size 2MB
    }

    @rpc method POST OPTIONS
    handle @rpc {
        reverse_proxy zakura:8232
    }

    handle {
        respond "Method Not Allowed" 405
    }

    log {
        output file /var/log/caddy/rpc-access.log {
            roll_size 50MiB
            roll_keep 5
        }
    }
}
